{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["out/**", "!.vscode/**"]
		},
		"lint": {
			"dependsOn": ["^lint"],
			"cache": false
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"interactive": true
		}
	}
}
