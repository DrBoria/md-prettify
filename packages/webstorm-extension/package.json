{
  "name": "@md-prettify/webstorm-extension",
  "version": "1.0.0",
  "description": "WebStorm adapter for md-prettify — thin IDE layer over the IDE-agnostic backend.",
  "main": "./out/packages/webstorm-extension/activate.js",
  "types": "./out/packages/webstorm-extension/activate.d.ts",
  "files": [
    "out"
  ],
  "scripts": {
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "check:types": "tsc --noEmit",
    "test": "tsc -p ./ && node -e \"const M=require('mocha');const m=new M({ui:'tdd',timeout:30000});m.addFile('out/apps/backend/test/webstorm-host-adapter.test.js');m.addFile('out/apps/backend/test/webstorm-activation.test.js');m.addFile('out/apps/backend/test/no-ide-import.test.js');m.run((f)=>process.exit(f||0))\""
  },
  "dependencies": {
    "vscode-extension-devtool-mcp": "file:../../../Jabberwock/packages/vscode-extension-devtool-mcp"
  },
  "devDependencies": {
    "mocha": "^3.1.1",
    "typescript": "^5.5.0",
    "@md-prettify/tsconfig": "workspace:*"
  }
}
