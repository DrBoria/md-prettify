{
	"name": "@md-prettify/webstorm-extension",
	"version": "0.0.7-beta",
	"license": "Apache-2.0",
	"author": "DrBoria <dr.boria@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DrBoria/md-prettify.git"
	},
	"bugs": {
		"url": "https://github.com/DrBoria/md-prettify/issues"
	},
	"homepage": "https://github.com/DrBoria/md-prettify#readme",
	"description": "WebStorm adapter for md-prettify — thin IDE layer over the IDE-agnostic backend.",
	"main": "./activate.js",
	"files": [
		"*.ts",
		"package.json",
		"!debug-server.*"
	],
	"publishConfig": {
		"main": "./out/packages/webstorm-extension/index.js"
	},
	"scripts": {
		"build": "tsc -p ./",
		"compile": "tsc -p ./",
		"check:types": "tsc --noEmit",
		"test": "bash ../../apps/backend/scripts/build.sh webstorm > /dev/null && node -e \"const M=require('mocha');const m=new M({ui:'tdd',timeout:30000});m.addFile('out/apps/backend/test/webstorm-host-adapter.test.js');m.addFile('out/apps/backend/test/webstorm-activation.test.js');m.addFile('out/apps/backend/test/no-ide-import.test.js');m.run((f)=>process.exit(f||0))\""
	},
	"dependencies": {
		"@md-prettify/types": "workspace:*",
		"@md-prettify/utils": "workspace:*",
		"mobx": "^7.0.6",
		"mobx-state-tree": "^8.0.0",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.2.0"
	},
	"devDependencies": {
		"mocha": "^3.1.1",
		"typescript": "^5.5.0",
		"@md-prettify/tsconfig": "workspace:*",
		"vscode-extension-devtool-mcp": "file:../../../vscode-extension-devtool-mcp"
	}
}
